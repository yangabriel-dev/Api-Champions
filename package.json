{
  "name": "api-champions",
  "version": "1.0.0",
  "description": "API REST de jogadores e clubes da Champions League, feita com Node.js, Express e TypeScript.",
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx --env-file-if-exists=.env src/server.ts",
    "start:watch": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dist": "tsup src/server.ts --out-dir dist",
    "start:dist": "npm run dist && node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Yan Gabriel",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6"
  }
}
